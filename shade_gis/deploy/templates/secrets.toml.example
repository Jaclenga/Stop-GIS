# Copy these placeholders into your deployment host's secret manager.
# Never rename this file to secrets.toml and commit it.

SHADE_GIS_VOTE_DATABASE_URL = "postgresql://RUNTIME_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
SHADE_GIS_VOTE_FINGERPRINT_SECRET = "YOUR_BROWSER_GENERATED_SECRET"

# Optional OIDC configuration when account sign-in is required.
# [auth]
# redirect_uri = "https://YOUR_APP_HOST/oauth2callback"
# cookie_secret = "generate-a-different-long-random-value"
# client_id = "your-oidc-client-id"
# client_secret = "your-oidc-client-secret"
# server_metadata_url = "https://YOUR_PROVIDER/.well-known/openid-configuration"
