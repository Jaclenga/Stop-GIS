# Copy these placeholders into a server-side secret manager. Do not commit real values.
SHADE_GIS_VOTE_DATABASE_URL=postgresql://RUNTIME_USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SHADE_GIS_VOTE_FINGERPRINT_SECRET=YOUR_BROWSER_GENERATED_SECRET
# Set true only when every request reaches the app through a trusted proxy that
# overwrites Forwarded/X-Forwarded-For/CF-Connecting-IP headers.
SHADE_GIS_TRUST_PROXY_HEADERS=false
